function init(self)
	msg.post(".","acquire_input_focus")  -- "." é igual a self
	self.runSpeed = 50  -- 50 pixel por segundo
	self.curAnim = "idle"
	msg.post("#sprite", "play_animation", { id=hash("idle") })
	self.speed = vmath.vector3()
	-- particlefx.play("#player1")
end

function update(self, dt)
	local pos = go.get_position()

	if self.speed.x ~= 0 then    
		pos = pos + self.speed * dt
		go.set_position(pos)

		-- Só envia a animação se ela já não estiver tocando
		if self.curAnim ~= "run" then
			msg.post("#sprite", "play_animation", { id = hash("run") })
			self.curAnim = "run"
		end
	else
		-- Só envia a animação idle UMA VEZ quando o personagem parar
		if self.curAnim ~= "idle" then
			msg.post("#sprite", "play_animation", { id = hash("idle") })
			self.curAnim = "idle"
		end
	end
end

function on_input(self, action_id, action)
	-- Movimentação para a Direita
	if action_id == hash("MOVE_RIGHT") then
		if action.released then
			self.speed.x = 0
		else
			self.speed.x = self.runSpeed
			sprite.set_hflip("#sprite", false)
		end

		-- Movimentação para a Esquerda
	elseif action_id == hash("MOVE_LEFT") then
		if action.released then
			self.speed.x = 0
		else
			self.speed.x = self.runSpeed * -1
			sprite.set_hflip("#sprite", true)
		end
	end
	--[[ if action_id == hash("SAI") then
	msg.post("go#mainmenu", "load")
	msg.post("go#mainmenu", "enable")
	msg.post(disable, self)
	msg.post(unload, self)
end ]]
end