[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 1024
height = 640
high_dpi = 1
update_frequency = 60

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01
use_fixed_timestep = 1
debug = 0

[html5]
scale_mode = stretch

[project]
title = PlataformerTutorial
developer = Paulo Sergio Zanetti

